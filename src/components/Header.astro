---
import { SITE } from '../config';
import ThemeToggle from './ThemeToggle.astro';

const { pathname } = Astro.url;
---
<header class="site-header">
  <div class="container">
    <a class="brand" href="/">
      <span class="brand-name">{SITE.name}</span>
      <span class="brand-en">Apple Dev Weekly</span>
    </a>
    <div class="header-tools">
      <ThemeToggle />
      <a class="rss-link" href="/rss.xml" title="RSS 订阅">
        RSS
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg>
      </a>
    </div>
  </div>
  <nav class="nav-row">
    <div class="container">
      {SITE.nav.map((item) => (
        <a
          href={item.href}
          class={item.href === '/' ? (pathname === '/' ? 'active' : '') : pathname.startsWith(item.href) ? 'active' : ''}
        >
          {item.label}
        </a>
      ))}
    </div>
  </nav>
</header>
