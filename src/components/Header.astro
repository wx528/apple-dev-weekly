---
import { SITE } from '../config';

const { pathname } = Astro.url;
---
<header class="site-header">
  <div class="container">
    <a class="brand" href="/">{SITE.name}</a>
    <nav>
      {SITE.nav.map((item) => (
        <a
          href={item.href}
          class={item.href === '/' ? (pathname === '/' ? 'active' : '') : pathname.startsWith(item.href) ? 'active' : ''}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>
